NEXT_PUBLIC_APP_NAME=Pokecrack
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Vercel server-only. Never prefix this key with NEXT_PUBLIC_ or send it to the VPS worker.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
ADMIN_EMAILS=
ADMIN_CONTROL_RPC_ENABLED=false
DATA_MODE=demo

AI_PROVIDER=fixture
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_EXTRACT_MODEL=
AI_VALIDATE_MODEL=
AI_ESCALATE_MODEL=
# Required to be positive when AI_PROVIDER is openai_compatible/http.
AI_INPUT_PER_MILLION_AUD=0
AI_OUTPUT_PER_MILLION_AUD=0
AI_MAX_OUTPUT_TOKENS=4096
AI_DAILY_BUDGET_AUD=5
AI_MONTHLY_SOFT_BUDGET_AUD=50
AI_MIN_ACCEPT_CONFIDENCE=0.92
AI_MIN_FIELD_CONFIDENCE=0.85
AI_MAX_SOURCE_ITEMS_PER_RUN=100
AI_MAX_TEXT_CHARS=20000
AI_MAX_IMAGES=6
AI_MAX_KEYFRAMES=12
AI_MAX_VIDEO_SECONDS=900
AI_CONCURRENCY=2

YOUTUBE_API_KEY=
MATON_API_KEY=
YOUTUBE_MATON_CONNECTION_ID=
YOUTUBE_COLLECTION_ENABLED=false
PUBLIC_STUDY_COLLECTION_ENABLED=false

SCRAPLING_ENABLED=true
SCRAPLING_HTTP_CONCURRENCY=4
SCRAPLING_PER_DOMAIN_CONCURRENCY=2
SCRAPLING_BROWSER_CONCURRENCY=1
SCRAPLING_REQUEST_TIMEOUT_SECONDS=30
SCRAPLING_DEFAULT_DELAY_SECONDS=8
SCRAPLING_DYNAMIC_ENABLED=false
SCRAPLING_SAVE_RAW_HTML=false
SCRAPLING_MAX_RAW_TEXT_CHARS=20000

OPENCLI_ENABLED=false
OPENCLI_VERSION=
OPENCLI_EXTENSION_VERSION=
OPENCLI_EXTENSION_SHA256=
OPENCLI_EXTENSION_URL=
OPENCLI_EXTENSION_DIR=/opt/pokecrack/opencli-extension
OPENCLI_DAEMON_HOST=127.0.0.1
OPENCLI_DAEMON_PORT=19825
OPENCLI_COMMAND_TIMEOUT_SECONDS=120
OPENCLI_MAX_OUTPUT_BYTES=1048576

CHROMIUM_PROFILE_ROOT=/profiles
CHROMIUM_PROFILE=research-general
CHROMIUM_CDP_HOST=127.0.0.1
CHROMIUM_CDP_PORT=9222
CHROMIUM_MAX_PROFILES_RUNNING=1
CHROMIUM_EXECUTABLE_PATH=

NOVNC_ENABLED=true
NOVNC_BIND_HOST=127.0.0.1
NOVNC_PORT=6080
NOVNC_PASSWORD_FILE=/etc/pokecrack/novnc-password

WORKER_ID=
WORKER_POLL_SECONDS=10
WORKER_MAX_CONCURRENCY=1

BAYES_PRIOR_STRENGTH=50
MIN_RATE_DISPLAY_PACKS=30
MIN_SIGNAL_PACKS=200
MIN_SIGNAL_SOURCES=3
MIN_WATCH_PROBABILITY=0.90
MIN_ANOMALY_PROBABILITY=0.95
MIN_PRACTICAL_UPLIFT=0.20

DATABASE_WARNING_MB=350
DATABASE_CRITICAL_MB=425
STORAGE_WARNING_MB=700
STORAGE_CRITICAL_MB=850
MONTHLY_EGRESS_WARNING_GB=3.5

BACKUP_DIR=/opt/pokecrack/backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
PROFILE_BACKUP_ENABLED=false
PROFILE_BACKUP_ENCRYPTION_KEY_FILE=


# Host-only Docker Compose paths
CHROMIUM_PROFILE_ROOT_HOST=/opt/pokecrack/browser-profiles

SCHEDULE_OFFICIAL_API=0 */6 * * *
SCHEDULE_PUBLIC_COLLECTION=15 4 * * *
SCHEDULE_AUTH_COLLECTION=30 */12 * * *
SCHEDULE_CATALOG_SYNC=0 2 * * *
SCHEDULE_AGGREGATES=5 * * * *
SCHEDULE_CLEANUP=30 3 * * *
SCHEDULE_BACKUP=0 4 * * *
SCHEDULE_BROWSER_CHECK=*/30 * * * *

WATCHDOG_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
