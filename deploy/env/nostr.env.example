# Copy outside the repository to /etc/pokecrack/nostr.env and chmod 0600.
# This file is accepted only by the exact tcgdex-nostr service set. It is used
# for Compose interpolation and the host-side attestation; it is never mounted
# wholesale into a container.
DATA_MODE=live
NOSTR_COLLECTION_ENABLED=true
# Dedicated NOINHERIT login. Include sslmode=require (or stronger), a bounded
# connect_timeout, and exactly options=-c role=pokecrack_nostr_worker.
NOSTR_SUPABASE_DB_URL=
# Distinct dedicated NOINHERIT login targeting the same host/port/database.
# Include exactly options=-c role=pokecrack_nostr_attestor.
SUPABASE_NOSTR_PREFLIGHT_DB_URL=
