# Copy outside the repository to /etc/pokecrack/bluesky.env and chmod 0600.
# This file is accepted only by the opt-in bluesky Compose profile. Keep it
# separate from production.env: it contains the dedicated NOINHERIT login DSN.
DATA_MODE=live
BLUESKY_COLLECTION_ENABLED=true
# Dedicated login; include sslmode=require (or stronger), a bounded
# connect_timeout, and exactly options=-c role=pokecrack_bluesky_worker.
BLUESKY_SUPABASE_DB_URL=
