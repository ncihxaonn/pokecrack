# Copy outside the repository to /etc/pokecrack/production.env and chmod 0600.
DATA_MODE=demo
AI_PROVIDER=fixture
LOG_LEVEL=INFO
# Live deployments require a dedicated TLS PostgreSQL URL. Add a bounded
# connect_timeout in the URL; do not reuse a browser/service-role credential.
SUPABASE_DB_URL=
# Dedicated pokecrack_runtime_monitor_login URL for the private aggregate-only
# release verifier. Provision it as NOINHERIT, NOSUPERUSER, NOCREATEDB,
# NOCREATEROLE, NOREPLICATION, NOBYPASSRLS, CONNECTION LIMIT 2, with only
# membership in pokecrack_runtime_monitor (INHERIT FALSE, SET TRUE). It is
# passed only to the watchdog; never use service_role here.
RUNTIME_RELEASE_EVIDENCE_DB_URL=
YOUTUBE_API_KEY=
# Alternative to a raw Google key: the Personal Maton API credential and the
# exact already-authorized YouTube connection UUID. Configure one path only.
MATON_API_KEY=
YOUTUBE_MATON_CONNECTION_ID=
YOUTUBE_COLLECTION_ENABLED=false
PUBLIC_STUDY_COLLECTION_ENABLED=false
BLUESKY_COLLECTION_ENABLED=false
NOSTR_COLLECTION_ENABLED=false
# Nostr credentials never belong in this shared file. The explicit
# tcgdex-nostr service set layers mode-0600 /etc/pokecrack/nostr.env instead.
MASTODON_COLLECTION_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_EXTRACT_MODEL=
AI_VALIDATE_MODEL=
AI_ESCALATE_MODEL=
# Required to be positive when AI_PROVIDER is openai_compatible/http.
AI_INPUT_PER_MILLION_AUD=0
AI_OUTPUT_PER_MILLION_AUD=0
AI_MAX_OUTPUT_TOKENS=4096
OPENCLI_ENABLED=false
OPENCLI_VERSION=
OPENCLI_EXTENSION_VERSION=
OPENCLI_EXTENSION_SHA256=
OPENCLI_EXTENSION_URL=
CHROMIUM_PROFILE=research-general
NOVNC_PASSWORD_FILE=/etc/pokecrack/novnc-password
CHROMIUM_PROFILE_ROOT_HOST=/opt/pokecrack/browser-profiles
OPENCLI_EXTENSION_DIR=/opt/pokecrack/opencli-extension
BACKUP_DIR=/opt/pokecrack/backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
WORKER_MAX_CONCURRENCY=1
SCHEDULE_CATALOG_SYNC=0 2,14 * * *
SCHEDULE_OFFICIAL_API=0 */6 * * *
SCHEDULE_BLUESKY_COLLECTION=* * * * *
SCHEDULE_MASTODON_COLLECTION=*/5 * * * *
COLLECTOR_CPUS=0.35
COLLECTOR_MEMORY=384m
AUTH_BROWSER_CPUS=0.65
AUTH_BROWSER_MEMORY=1536m
AI_WORKER_CPUS=0.40
AI_WORKER_MEMORY=768m
AGGREGATOR_CPUS=0.20
AGGREGATOR_MEMORY=384m
SCHEDULER_CPUS=0.10
SCHEDULER_MEMORY=192m
WATCHDOG_CPUS=0.10
WATCHDOG_MEMORY=192m
NOSTR_COLLECTOR_CPUS=0.20
NOSTR_COLLECTOR_MEMORY=256m
