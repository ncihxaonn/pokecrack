# syntax=docker/dockerfile:1.7
ARG PYTHON_IMAGE=python:3.13.5-slim-bookworm@sha256:4c2cf9917bd1cbacc5e9b07320025bdb7cdf2df7b0ceaccb55e9dd7e30987419
FROM ${PYTHON_IMAGE}

ARG UV_VERSION=0.11.6
ARG DEPLOY_SHA
LABEL org.opencontainers.image.title="pokecrack-worker" \
      org.opencontainers.image.description="Policy-gated Pokecrack worker runtime" \
      com.pokecrack.runtime="worker" \
      org.opencontainers.image.revision="${DEPLOY_SHA}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH=/app/services/worker/.venv/bin:$PATH

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 pokecrack \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin pokecrack

WORKDIR /app/services/worker
COPY services/worker/pyproject.toml services/worker/uv.lock ./
COPY services/worker/pokecrack_worker ./pokecrack_worker
COPY config /app/config
COPY deploy/certs/supabase-prod-ca-2021.crt /run/supabase-prod-ca-2021.crt
COPY deploy/worker-service-entrypoint.sh /usr/local/bin/worker-service-entrypoint
RUN python -m pip install --no-cache-dir "uv==${UV_VERSION}" \
    && uv sync --frozen --no-dev --extra scrapling \
    && chmod 0755 /usr/local/bin/worker-service-entrypoint \
    && chown -R 10001:10001 /app

USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/worker-service-entrypoint"]
CMD ["collector"]
