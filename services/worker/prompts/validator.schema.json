{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "observed",
    "overall_confidence",
    "eligible_for_statistics",
    "evidence_tier",
    "field_checks",
    "contradictions",
    "missing_required_fields",
    "duplicate_suspected",
    "rejection_reasons"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "accept",
        "activity_only",
        "reject"
      ]
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set_name",
        "product_name",
        "product_type",
        "pack_count",
        "is_complete",
        "hits",
        "country_code",
        "region",
        "retailer",
        "batch_code",
        "opened_at"
      ],
      "properties": {
        "set_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "product_type": {
          "type": "string",
          "enum": [
            "booster_box",
            "etb",
            "booster_bundle",
            "other",
            "unknown"
          ]
        },
        "pack_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "is_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "hits": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "card_name",
              "collector_number",
              "rarity_key",
              "quantity"
            ],
            "properties": {
              "card_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "collector_number": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "rarity_key": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              }
            }
          }
        },
        "country_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "retailer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "batch_code": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "opened_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "eligible_for_statistics": {
      "type": "boolean"
    },
    "evidence_tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "field_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "status",
          "confidence",
          "evidence_reference"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "contradicted",
              "unsupported",
              "not_applicable"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_reference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "missing_required_fields": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "duplicate_suspected": {
      "type": "boolean"
    },
    "rejection_reasons": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    }
  }
}
