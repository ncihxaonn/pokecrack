{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_type",
    "decision",
    "set",
    "product",
    "opening",
    "location",
    "purchase",
    "hits",
    "evidence_tier_candidate",
    "overall_confidence",
    "missing_fields",
    "warnings"
  ],
  "properties": {
    "content_type": {
      "type": "string",
      "enum": [
        "video",
        "article",
        "social_post",
        "product_listing",
        "manual_import",
        "unknown"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "candidate",
        "activity_only",
        "reject"
      ]
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "confidence",
        "evidence_reference"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "confidence",
        "evidence_reference"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "type": {
          "type": "string",
          "enum": [
            "booster_box",
            "etb",
            "booster_bundle",
            "other",
            "unknown"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_count",
        "is_complete",
        "opened_at",
        "confidence",
        "evidence_reference"
      ],
      "properties": {
        "pack_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "is_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "opened_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "region",
        "confidence",
        "evidence_reference"
      ],
      "properties": {
        "country_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "purchase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retailer",
        "batch_code",
        "confidence",
        "evidence_reference"
      ],
      "properties": {
        "retailer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "batch_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "hits": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_name",
          "collector_number",
          "rarity",
          "quantity",
          "confidence",
          "evidence_reference"
        ],
        "properties": {
          "card_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "collector_number": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64
          },
          "rarity": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_reference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "evidence_tier_candidate": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "missing_fields": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
